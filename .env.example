# Platform Configuration
# These tokens represent the external services and configurations required for Altay Studio to operate.
# Note: For Supabase Edge Functions, these must be set as Supabase Secrets via `npx supabase secrets set`.
# For local frontend development, Vite environment variables (VITE_*) would go in `.env.local`

# Server-only secrets for Supabase Edge Functions.
# Do not expose this as VITE_* or NEXT_PUBLIC_*.
APOLLO_API_KEY=
CLAY_WEBHOOK_SECRET=

# --- GitHub Integration ---
# Token with repo scope to clone/manage templates
GITHUB_TOKEN=""

# Specific template repo identifiers/URLs
GITHUB_TEMPLATE_BARBER=""
GITHUB_TEMPLATE_CLINIC=""
GITHUB_TEMPLATE_BESPOKE=""

# --- Vercel Integration ---
# Token for provisioning new deployments via Vercel REST API
VERCEL_API_TOKEN=""

# Vercel Team ID (e.g. team_xxxxxx) — required so API calls are scoped to the correct team
VERCEL_TEAM_ID=""

# --- DNS & Domains ---
# DNS is managed via Cloudflare. A wildcard CNAME (*.altaystudio.com → cname.vercel-dns.com)
# is configured once in the Cloudflare dashboard — no per-client DNS API calls are needed.
# The tokens below are available for future Cloudflare API use (e.g. bulk record management).
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# --- Email Integration ---
# Resend API Key for sending transactional emails (welcome emails, etc.)
RESEND_API_KEY=""

# --- Supabase Database & Auth ---
# Master Database URL (Postgres connection string) for dynamic schema creation
SUPABASE_DB_URL=""

# Dedicated or secondary Database URL specifically for Altaay
ALTAY_DB_URL=""

# Publishable/Public keys for client-side access
SUPABASE_PUBLISHABLE_KEYS=""

# Secret keys for backend administrative access
SUPABASE_SECRET_KEYS=""

# Anonymous key (usually injected by Supabase locally, but documented here)
SUPABASE_ANON_KEY=""

# Service Role Key for bypassing RLS during provisioning
SUPABASE_SERVICE_ROLE_KEY=""

# JSON Web Key Set for Auth
SUPABASE_JWKS=""

# --- Supabase Infrastructure (Edge/Deploy) ---
SB_REGION=""
SB_EXECUTION_ID=""
DENO_DEPLOYMENT_ID=""

# --- Agentic OS (Agent Director) ---
# Anthropic API Key for Claude 3.5 Sonnet — powers the ReAct reasoning loop
ANTHROPIC_API_KEY=""

# OpenAI API Key for text-embedding-3-small — generates memory embeddings
OPENAI_API_KEY=""
